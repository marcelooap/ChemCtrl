{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@industrializacao/*": ["./src/modules/industrializacao/*"],
      "@transbordo/*": ["./src/modules/transbordo/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
